# hosts.env — fill in after launching the instances, then `source` it.
# SkyWalker-style 3-region AWS testbed with the §3 simulation's
# supply-census-proportional (UNBALANCED) node distribution:
# NODES_PER_REGION_LIST=[30,13,8,3,3,3,2,2] aggregated onto 3 regions
# (US=30 | EU=DE+GB=11 | Asia=CN+JP+SG+KR+AU=23) and scaled to 12 GPUs:
#   region 0: us-east-1       6 × g6.xlarge (1×L4 ea.) + 1 × c6i.2xlarge
#   region 1: eu-central-1    2 × g6.xlarge            + 1 × c6i.2xlarge
#   region 2: ap-northeast-1  4 × g6.xlarge            + 1 × c6i.2xlarge
# (supply is decoupled from demand — the demand split is US .453 /
#  EU .159 / Asia .388, set at trace-generation time via --region-weights.)
# Any per-region counts work: just add/remove IPs below; the region map
# is derived from the array lengths.
#
# Use PUBLIC IPs (or VPC-peered private IPs) reachable across regions.
# Security groups: allow 30000 (SGLang) + 8001 (router) between all
# testbed IPs and SSH (22) from your control machine only.

export SSH_USER="ubuntu"
export SSH_KEY="$HOME/.ssh/id_ed25519"

export REGION_NAMES=("us-east-1" "eu-central-1" "ap-northeast-1")

# One router (CPU) node per region.
export ROUTER_HOSTS=("R0.PUBLIC.IP" "R1.PUBLIC.IP" "R2.PUBLIC.IP")

# GPU worker nodes per region (region-major order, counts may differ).
export WORKER_HOSTS_0=("W00.IP" "W01.IP" "W02.IP" "W03.IP" "W04.IP" "W05.IP")  # us-east-1 ×6
export WORKER_HOSTS_1=("W10.IP" "W11.IP")                                      # eu-central-1 ×2
export WORKER_HOSTS_2=("W20.IP" "W21.IP" "W22.IP" "W23.IP")                    # ap-northeast-1 ×4

export MODEL_NAME="meta-llama/Llama-3.1-8B-Instruct"
export HF_TOKEN="hf_..."            # gated model — needed on worker nodes

export ROUTER_PORT=8001
export SGLANG_PORT=30000
export REPO_DIR="~/KVCompass/realmachine"

# Derived (do not edit): worker URLs region-major + region map from the
# array lengths.
_all_workers=("${WORKER_HOSTS_0[@]}" "${WORKER_HOSTS_1[@]}" "${WORKER_HOSTS_2[@]}")
export SGLANG_WORKER_URLS=$(printf "http://%s:${SGLANG_PORT}," "${_all_workers[@]}" | sed 's/,$//')
export WORKER_REGIONS=$( {
  for _ in "${WORKER_HOSTS_0[@]}"; do printf "0,"; done
  for _ in "${WORKER_HOSTS_1[@]}"; do printf "1,"; done
  for _ in "${WORKER_HOSTS_2[@]}"; do printf "2,"; done
} | sed 's/,$//')
