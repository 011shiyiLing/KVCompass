# hosts.env — the rented Vast.ai boxes for one testbed run (example layout).
#   region 0: US    x.x.x.x  8 × RTX 5090
#   region 1: EU    x.x.x.x  2 × RTX 5090
#   region 2: Asia  x.x.x.x  4 × RTX 5090
#
# Networking: the rented instances do NOT map our service ports, so all
# cross-box traffic flows through an SSH tunnel mesh (tunnel_mesh.sh):
# on every box, remote box b's worker i is reachable at
#   127.0.0.1:$((40000 + b*100 + i))          (worker internal 30000+i)
# and remote box b's router at
#   127.0.0.1:$((40000 + b*100 + 99))         (router internal 8001)
# Own-region services use loopback directly (30000+i / 8001).

export REGION_NAMES=("us" "eu" "asia")

export BOX_IP=("US.IP" "EU.IP" "ASIA.IP")
export BOX_SSH_PORT=(11111 22222 33333)
export SSH_USER="root"
export SSH_KEY="${SSH_KEY:-$HOME/.ssh/id_ed25519}"

export GPUS_PER_BOX=(8 2 4)

export MODEL_NAME="meta-llama/Llama-3.1-8B-Instruct"
export HF_TOKEN="hf_..."
export REPO_DIR="/root/KVCompass/realmachine"

# 5090 calibration — refreshed by scripts/vast/calibrate_prefill.py.
export C_PREFILL_MS_PER_TOKEN_PRIOR=0.02
export PCIE_RELOAD_MS_PER_TOKEN=0.0026

# ── Derived (do not edit) ───────────────────────────────────────────────
export WORKER_REGIONS=$( {
  for i in $(seq 1 "${GPUS_PER_BOX[0]}"); do printf "0,"; done
  for i in $(seq 1 "${GPUS_PER_BOX[1]}"); do printf "1,"; done
  for i in $(seq 1 "${GPUS_PER_BOX[2]}"); do printf "2,"; done
} | sed 's/,$//')

# Tunnel port helpers (same scheme on every box).
tunnel_worker_port() { echo $((40000 + $1 * 100 + $2)); }   # box, gpu
tunnel_router_port() { echo $((40000 + $1 * 100 + 99)); }   # box
